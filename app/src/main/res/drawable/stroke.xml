<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
android:shape="rectangle">

<!-- The border thickness and color -->
<stroke
    android:width="2dp"
    android:color="?attr/colorOutline" /> <!-- Black border -->

<!-- The inside color of the view (transparent or solid) -->
<solid android:color="@android:color/transparent" />

<!-- Optional: Rounded corners -->
<corners android:radius="8dp" />

<!-- Optional: Space between the border and content -->
<padding
    android:left="0dp"
    android:top="0dp"
    android:right="0dp"
    android:bottom="0dp" />
</shape>