<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Display Large (57sp) -->
    <style name="TextAppearance.MyApp.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">57sp</item>
        <item name="android:letterSpacing">-0.01</item> <!-- Approximately -0.25sp -->
        <item name="android:textFontWeight">400</item> <!-- Regular -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Headline Large (32sp) -->
    <style name="TextAppearance.MyApp.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textFontWeight">400</item> <!-- Regular -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Title Large (22sp) -->
    <style name="TextAppearance.MyApp.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textFontWeight">500</item> <!-- Medium -->
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- Body Large (16sp) -->
    <style name="TextAppearance.MyApp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.03</item> <!-- Approximately 0.5sp -->
        <item name="android:textFontWeight">400</item> <!-- Regular -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Body Medium (14sp) -->
    <style name="TextAppearance.MyApp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item> <!-- Approximately 0.25sp -->
        <item name="android:textFontWeight">400</item> <!-- Regular -->
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Label Large (14sp) -->
    <style name="TextAppearance.MyApp.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item> <!-- Approximately 0.1sp -->
        <item name="android:textFontWeight">500</item> <!-- Medium -->
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>
