<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/main_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/main_second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vassilis" />

    <Button
        android:id="@+id/main_btn_sample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample Button" />

    <Button
        android:id="@+id/main_btn_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Network Button" />

    <Button
        android:id="@+id/main_btn_database"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Database Button" />

    <Button
        android:id="@+id/main_btn_sample_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample" />

    <Button
        android:id="@+id/main_btn_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RecyclerView" />

    <Button
        android:id="@+id/main_btn_preferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preferences" />

    <Button
        android:id="@+id/main_btn_fragments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fragments" />


</LinearLayout>
